--Se référer au GPR Tools User's Guide pour comprendre notre démarche.
project Huffman_Compression is

    -- les valeurs possibles du mode employé
    type Mode_Type is ("test", "release");
    --variable typée, similaire à l'énumération
    Mode : Mode_Type := external ("mode", "release");

    -- le /** permet de récupérer les sous-dossiers avec
    for Source_Dirs use ("src/**");
    -- external retourne la valeur du mode, avec comme valeur par défaut "release"
    for Object_Dir use "obj" & external ("mode", "release"); 

    -- Gestion de scénario avec un case switch
    case Mode is
        when "test" =>
            for Main use ("test_arbre.adb");
            for Exec_Dir use "tests";
        when "release" =>
            for Main use ("compression.adb","decompression.adb");
            for Exec_Dir use "results";        
    end case;

    --copié du pr02.
    package Builder is
        for Default_Switches ("Ada") use ("-s");
    end Builder;

    package Compiler is
        for Default_Switches ("Ada") use ("-gnatwa", "gnata", "-g" );
    end Compiler;

    package Binder is
        for Default_Switches ("Ada") use ("-E");
    end Binder;

end Huffman_Compression;