<mxCell id="fq" value="&lt;b&gt;Adaptation au facteur de qualité FQ (0 à 97) :&lt;/b&gt;&lt;br&gt;FQ ≤ 50 : T(FQ) = 50 · T⁽⁵⁰⁾ / FQ&lt;br&gt;FQ &gt; 50 : T(FQ) = (100 − FQ) · T⁽⁵⁰⁾ / 50&lt;br&gt;&lt;br&gt;Quantification : bloc_Q = round(bloc / T)&lt;br&gt;Inverse : bloc = round(bloc_Q × T)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="330" height="150" as="geometry"/></mxCell>
